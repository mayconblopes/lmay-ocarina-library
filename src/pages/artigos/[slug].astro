---
import { CollectionEntry, getCollection, render } from 'astro:content'
import RelatedArticles from '../../components/RelatedArticles.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import YouTube from '../../components/YouTube.astro'
import { resolveArticleAsset } from '../../lib/article-assets'

type Article = CollectionEntry<'articles'>

export async function getStaticPaths() {
  const articles = await getCollection('articles')

  return articles.map((article: Article) => ({
    params: {
      slug: article.id,
    },
    props: {
      article,
    },
  }))
}

const { article } = Astro.props
const { Content } = await render(article)

const coverUrl = resolveArticleAsset(article.id, article.data.cover)

const allArticles = await getCollection('articles')

const relatedArticles = article.data.related
  .map((id: string) => allArticles.find((item: Article) => item.id === id))
  .filter((item: Article): item is Article => Boolean(item))
  .map((item: Article) => ({
    id: item.id,
    title: item.data.title,
    description: item.data.description,
  }))
---

<BaseLayout
  title={`${article.data.title} — L.May Ocarina Library`}
  description={article.data.description}
>
  <article class='mx-auto max-w-3xl'>
    <!-- Cabeçalho -->

    {
      coverUrl && (
        <figure class='mb-12 overflow-hidden rounded-2xl border border-border bg-muted'>
          <img
            src={coverUrl}
            alt={article.data.title}
            class='h-auto w-full object-cover'
          />
        </figure>
      )
    }

    <header class='mb-12'>
      <a
        href={`${import.meta.env.BASE_URL}/artigos/`}
        class='text-sm font-medium text-primary transition-opacity hover:opacity-80'
      >
        ← Voltar para artigos
      </a>

      <p
        class='mt-8 text-sm font-semibold uppercase tracking-[0.18em] text-primary'
      >
        Artigo
      </p>

      <h1
        class='mt-3 font-serif text-4xl font-semibold tracking-tight sm:text-5xl'
      >
        {article.data.title}
      </h1>

      <p class='mt-5 text-lg leading-8 text-muted-foreground'>
        {article.data.description}
      </p>

      {
        article.data.tags.length > 0 && (
          <div class='mt-6 flex flex-wrap gap-2'>
            {article.data.tags.map((tag: string) => (
              <span class='rounded-full bg-primary-soft px-2.5 py-1 text-xs font-medium text-primary'>
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <!-- Conteúdo -->

    <div
      class='prose
        prose-lg
        max-w-none
        text-foreground
        prose-headings:font-serif
        prose-headings:font-semibold
        prose-headings:tracking-tight
        prose-h2:mt-12
        prose-h2:text-3xl
        prose-h3:mt-10
        prose-h3:text-2xl
        prose-p:leading-8
        prose-p:text-foreground/90
        prose-a:text-primary
        prose-a:no-underline
        hover:prose-a:underline
        prose-strong:text-foreground
        prose-blockquote:border-primary
        prose-blockquote:text-muted-foreground
        prose-li:leading-8'
    >
      <Content components={{ YouTube }} />
    </div>

    <!-- Conteúdos relacionados -->

    <RelatedArticles articles={relatedArticles} />

    <!-- Navegação final -->

    <footer class='mt-16 border-t border-border pt-8'>
      <a
        href={`${import.meta.env.BASE_URL}/artigos/`}
        class='inline-flex items-center text-sm font-semibold text-primary transition-opacity hover:opacity-80'
      >
        ← Voltar para artigos
      </a>
    </footer>
  </article>
</BaseLayout>
