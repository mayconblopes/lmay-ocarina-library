---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

type Article = CollectionEntry<'articles'>

const articles = await getCollection('articles')
---

<html lang='pt-BR'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <title>Artigos — L.May Ocarina Library</title>
    <meta
      name='description'
      content='Artigos e conteúdos de estudo sobre ocarina.'
    />
  </head>

  <body>
    <main>
      <header>
        <h1>Artigos</h1>
        <p>Conteúdos de estudo sobre ocarina.</p>
      </header>

      <section>
        {
          articles.map((article: Article) => (
            <article>
              <h2>
                <a href={`${import.meta.env.BASE_URL}artigos/${article.id}/`}>
                  {article.data.title}
                </a>
              </h2>

              <p>{article.data.description}</p>

              {article.data.tags.length > 0 && (
                <ul>
                  {article.data.tags.map((tag: string) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </section>
    </main>
  </body>
</html>
