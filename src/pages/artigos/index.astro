---
import { getCollection, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getLocalizedArticles } from '../../lib/articles'

type Article = CollectionEntry<'articles'>
const articles = getLocalizedArticles(await getCollection('articles'), 'pt-BR')
---

<BaseLayout
  title='Artigos — L.May Ocarina Library'
  description='Explore os artigos e conteúdos da L.May Ocarina Library.'
>
  <div class='space-y-14'>
    <!-- Cabeçalho da biblioteca -->

    <header class='max-w-3xl'>
      <p class='text-sm font-semibold uppercase tracking-[0.18em] text-primary'>
        Biblioteca
      </p>

      <h1
        class='mt-3 font-serif text-4xl font-semibold tracking-tight sm:text-5xl'
      >
        Artigos
      </h1>

      <p class='mt-5 text-lg leading-8 text-muted-foreground'>
        Conteúdos para estudar ocarina, música, técnica e tudo aquilo que pode
        ajudar você a compreender melhor o instrumento.
      </p>
    </header>

    <!-- Lista de artigos -->

    <section aria-label='Lista de artigos'>
      {
        articles.length > 0 ? (
          <div class='grid gap-6 md:grid-cols-2'>
            {articles.map((article: Article) => (
              <article class='group rounded-lg border border-border bg-surface p-7 transition-shadow hover:shadow-sm'>
                <div class='flex h-full flex-col'>
                  <div class='flex-1'>
                    <h2 class='font-serif text-2xl font-semibold tracking-tight'>
                      <a
                        href={`${import.meta.env.BASE_URL}/artigos/${article.data.slug}/`}
                        class='transition-colors group-hover:text-primary'
                      >
                        {article.data.title}
                      </a>
                    </h2>

                    <p class='mt-3 leading-7 text-muted-foreground'>
                      {article.data.description}
                    </p>
                  </div>

                  {article.data.tags.length > 0 && (
                    <div class='mt-6 flex flex-wrap gap-2'>
                      {article.data.tags.map((tag: string) => (
                        <span class='rounded-full bg-primary-soft px-2.5 py-1 text-xs font-medium text-primary'>
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}

                  <div class='mt-6'>
                    <a
                        href={`${import.meta.env.BASE_URL}/artigos/${article.data.slug}/`}
                      class='text-sm font-semibold text-primary transition-opacity hover:opacity-80'
                    >
                      Ler artigo →
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class='rounded-lg border border-dashed border-border bg-surface-muted px-6 py-12 text-center'>
            <h2 class='font-serif text-2xl font-semibold'>
              Ainda não há artigos publicados.
            </h2>

            <p class='mt-3 text-muted-foreground'>
              Novos conteúdos serão adicionados em breve.
            </p>
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>
