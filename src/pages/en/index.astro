---
import { getCollection, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { articlesPath, getTranslations } from '../../lib/i18n'
import { getLocalizedArticles } from '../../lib/articles'

const t = getTranslations('en')
const articles = getLocalizedArticles(await getCollection('articles'), 'en')
const recentArticles = articles.slice(0, 3)
type Article = CollectionEntry<'articles'>
---

<BaseLayout
  locale='en'
  title='L.May Ocarina Library'
  description='A knowledge library about the ocarina.'
>
  <div class='space-y-20'>
    <section class='max-w-3xl'>
      <p class='mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-primary'>
        Ocarina knowledge library
      </p>
      <h1 class='text-4xl font-semibold tracking-tight text-foreground sm:text-5xl'>
        {t.learnOcarina}
      </h1>
      <p class='mt-6 max-w-2xl text-lg leading-8 text-muted-foreground'>
        {t.homeDescription}
      </p>
      <div class='mt-8'>
        <a
          href={`${import.meta.env.BASE_URL}${articlesPath('en')}/`}
          class='inline-flex items-center rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white transition-colors hover:opacity-90'
        >
          {t.exploreArticles}
        </a>
      </div>
    </section>

    <section>
      <div class='flex items-end justify-between gap-6'>
        <div>
          <p class='text-sm font-semibold uppercase tracking-[0.18em] text-primary'>
            {t.library}
          </p>
          <h2 class='mt-2 font-serif text-3xl font-semibold tracking-tight'>
            {t.recentContent}
          </h2>
        </div>
        <a
          href={`${import.meta.env.BASE_URL}${articlesPath('en')}/`}
          class='hidden text-sm font-medium text-primary transition-colors hover:opacity-80 sm:block'
        >
          {t.seeAll}
        </a>
      </div>

      <div class='mt-8 grid gap-6 md:grid-cols-3'>
        {recentArticles.map((article: Article) => (
          <article class='group rounded-lg border border-border bg-surface p-6 transition-shadow hover:shadow-sm'>
            <h3 class='font-serif text-xl font-semibold tracking-tight'>
              <a
                href={`${import.meta.env.BASE_URL}/en/articles/${article.data.slug}/`}
                class='transition-colors group-hover:text-primary'
              >
                {article.data.title}
              </a>
            </h3>
            <p class='mt-3 text-sm leading-6 text-muted-foreground'>
              {article.data.description}
            </p>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
