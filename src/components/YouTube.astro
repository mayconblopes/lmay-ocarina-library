---
interface Props {
  id: string
  title?: string
}

const {
  id,
  title = 'Vídeo do YouTube',
} = Astro.props
---

<div class='my-10 overflow-hidden rounded-2xl border border-border bg-black shadow-sm'>
  <div class='aspect-video'>
    <iframe
      src={`https://www.youtube.com/embed/${id}`}
      title={title}
      class='h-full w-full'
      loading='lazy'
      allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
      allowfullscreen
    ></iframe>
  </div>
</div>