---
import { articlesPath, getTranslations, type Locale } from '../lib/i18n'

const baseUrl = import.meta.env.BASE_URL;
interface Props {
  locale?: Locale
}

const { locale = 'pt-BR' } = Astro.props
const t = getTranslations(locale)
---

<footer class="border-t border-border bg-background">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-8 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
  >
    <p>
      L.May Ocarina Library
    </p>

    <a
      href={`${baseUrl}${articlesPath(locale)}/`}
      class="font-medium transition-colors hover:text-primary"
    >
      {t.exploreArticles}
    </a>
  </div>
</footer>